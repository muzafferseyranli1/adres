# Yerelde: bu dosyayı ".env" adıyla kopyalayıp anahtarları yazın. Yayında (Coolify) aynı adlarla ortam değişkeni tanımlayın.
# .env dosyasını kimseyle paylaşmayın; git'e eklenmez.

# apiturkiye.com -> Panel > API Keys > "Yeni anahtar" (önce Core paketi için erişim talebi gerekir)
APITURKIYE_KEY=

# Yandex Maps API konsolu -> Geocoder API -> Connect. Ücretsiz limit: günde 1.000 istek.
YANDEX_GEOCODER_KEY=

# İsteğe bağlı: Google Places API (New) anahtarı
GOOGLE_PLACES_KEY=

# İsteğe bağlı sınırlar (varsayılanlar)
# APT_DAILY_MAX=950
# YANDEX_DAILY_MAX=900
# GOOGLE_DAILY_MAX=160
# RATE_PER_MIN=40
